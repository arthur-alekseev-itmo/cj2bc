public class MemberData <: ToString {
    private let typ: MemberType
    private let offset: UInt32
    private let name: String

    public init(name: String, typ: MemberType, offset: UInt32) {
        this.name = name
        this.typ = typ
        this.offset = offset
    }

    public func toString(): String {
        "${typ} ${name} ${offset}"
    }

    public func toMemberEntry(): BytecodeMemberEntry {
        BytecodeMemberEntry(StringHasher.getHash(name), typ.toUInt32(), offset)
    }
}

public class ClassData <: ToString {
    private let name: String
    private var baseName: ?String
    private let members: ArrayList<MemberData>
    private var fieldCount: UInt32
    private var staticFieldCount: UInt32

    public func getName(): String {
        name
    }

    public func setBaseName(baseName: String): Unit {
        this.baseName = Some(baseName)
    }

    public init(name: String, reservedFields: UInt32) {
        this.fieldCount = reservedFields
        this.baseName = None
        this.staticFieldCount = 0
        this.name = name
        this.members = ArrayList<MemberData>()
    }

    public func addMethod(name: String, offset: UInt32): Unit {
        let member = MemberData(name, MtMethod, offset)
        members.add(member)
    }

    public func addStaticMethod(name: String, offset: UInt32): Unit {
        let member = MemberData(name, MtStaticMethod, offset)
        members.add(member)
    }

    public func addCtor(name: String, offset: UInt32): Unit {
        let member = MemberData(name, MtCtor, offset)
        members.add(member)
    }

    public func addField(name: String, offset: UInt32): Unit {
        let member = MemberData(name, MtField, offset)
        members.add(member)
    }

    public func addNextField(name: String): Unit {
        addField(name, fieldCount)
        fieldCount++
    }

    public func addStaticField(name: String, offset: UInt32): Unit {
        let member = MemberData(name, MtStaticField, offset)
        members.add(member)
    }

    public func addNextStaticField(name: String): Unit {
        addStaticField(name, staticFieldCount)
        staticFieldCount++
    }

    public func getFieldCount(): UInt32 {
        fieldCount
    }

    public func toString(): String {
        let memberStrings = members.map { x => "- ${x}" }.toArray()
        let ext = baseName.map { x => " <: ${x}"} ?? ""
        let memberList = String.join(memberStrings, delimiter:"\n")
        "Class: ${name}${ext}\n${memberList}\n"
    }

    public func toClassHeader(): BytecodeClassHeader {
        let header = BytecodeClassHeader(StringHasher.getHash(name), baseName.map(StringHasher.getHash) ?? 0)
        members.map { m: MemberData => header.addMember(m.toMemberEntry()) }
        header
    }
}